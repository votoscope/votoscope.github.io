---
// Root: sends the visitor to the site in their browser's language,
// French by default (and without script).
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Votovision</title>
    <link rel="alternate" hreflang="fr" href="/fr/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <script is:inline>
      location.replace((navigator.languages ?? [navigator.language]).find((l) => /^(fr|en)/i.test(l))?.slice(0, 2).toLowerCase() === "en" ? "/en/" : "/fr/");
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/fr/" /></noscript>
  </head>
  <body>
    <p><a href="/fr/">Votovision en français</a> · <a href="/en/">Votovision in English</a></p>
  </body>
</html>
